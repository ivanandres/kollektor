{
  "name": "@kollektor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "build": "esbuild src/server.ts src/vercel.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --packages=external",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@kollektor/core": "workspace:*",
    "@kollektor/db": "workspace:*",
    "@kollektor/integrations": "workspace:*",
    "@kollektor/schemas": "workspace:*",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
