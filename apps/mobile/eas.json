{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost:3001/api" }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.kolektorz.app/api",
        "EXPO_PUBLIC_WEB_URL": "https://kolektorz.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.kolektorz.app/api",
        "EXPO_PUBLIC_WEB_URL": "https://kolektorz.app"
      }
    }
  },
  "submit": { "production": {} }
}
