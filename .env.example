# Database
DATABASE_URL=postgresql://kollektor:kollektor@localhost:5432/kollektor
TEST_DATABASE_URL=postgresql://kollektor:kollektor@localhost:5432/kollektor_test

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Discogs (https://www.discogs.com/settings/developers)
DISCOGS_USER_TOKEN=
DISCOGS_USER_AGENT=Kollektor/0.1 +https://github.com/ivanandres/kollektor

# Photo recognition (Anthropic)
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-4-5
VISION_DAILY_LIMIT=30

# Music links / lyrics
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
GENIUS_ACCESS_TOKEN=

# Email (password reset)
RESEND_API_KEY=
EMAIL_FROM=Kollektor <no-reply@example.com>

# Cron endpoints
CRON_SECRET=change-me
